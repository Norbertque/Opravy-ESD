# Zkopírujte do .env.local a doplňte. Soubor .env.local se do gitu nedostane.
#
# GEMINI_API_KEY: v AI Studiu ho appka dostane automaticky (panel Secrets),
# lokálně ho sem vložte jen když chcete zkoušet skutečný model.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: v AI Studiu se doplní samo, lokálně není potřeba.
APP_URL="MY_APP_URL"

# Testovací režim (jen lokálně, v AI Studiu NIKDY nezapínat):
# MOCK_GEMINI=1 – místo modelu vrací připravené výsledky pro testovací dokumenty
# MOCK_DISK=1   – místo Google Disku čte složku test-drive/
# MOCK_GEMINI=1
# MOCK_DISK=1
